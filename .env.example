# Copy this file to .env and fill in your values.
# Environment variables override anything set in config.yaml.

BOT_TOKEN=
WEBHOOK_SECRET=
WEBHOOK_PORT=8080

EXCLUDED_SENDER_IDS=          # comma-separated: 123456,789012
ADMIN_CACHE_TTL_HOURS=6

FORBIDDEN_WORDS=               # comma-separated
FORBIDDEN_TITLE_WORDS=         # comma-separated

MAX_CHARACTERS=1000
MAX_EMOTICONS=10
MAX_MENTIONS=3
NON_LATIN_THRESHOLD_PERCENT=30

BAN_DURATION_DAYS=30

WARN_ENABLED=true
WARN_MESSAGE_TEMPLATE=⚠️ @{username}, your message was removed: {reason}
WARN_AUTO_DELETE_SECONDS=10

FLOOD_MAX_MESSAGES=10
FLOOD_INTERVAL_MINUTES=1
FLOOD_ACTION=ban

SPAM_MAX_VIOLATIONS=3
SPAM_WINDOW_MINUTES=30
SPAM_ACTION=ban

FILTERS_DELETE_NEW_CHAT_MEMBERS=true
FILTERS_DELETE_LEFT_CHAT_MEMBER=true
FILTERS_DELETE_FORWARDED_MESSAGES=false
FILTERS_CHECK_NON_LATIN=true
